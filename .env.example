SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset (commented out) to use SQLite locally.
# Example for PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/ai_client_portal
# DATABASE_URL=

# Required for chat to work. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Leave blank to disable error monitoring (default in dev).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Local dev/demo accounts, one per role - created/updated by
# `python manage.py create_demo_users`. Leave blank to skip creating that role.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Production-only: database backups (see docs/BACKUP_RESTORE.md). Not used
# locally - the backup_database command no-ops on SQLite regardless.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
BACKUP_RETENTION_DAYS=30

# Background jobs (notification emails, daily trial-expiry sweep). Leave
# blank locally - tasks then run synchronously in-process instead of being
# queued (see config/settings.py CELERY_TASK_ALWAYS_EAGER).
REDIS_URL=

# Notification emails. Leave blank locally - emails print to the console
# instead of being sent (see logs/app.log or the terminal running the server).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
