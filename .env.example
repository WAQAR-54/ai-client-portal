SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# "production" or "development" (default). docker-compose.yml (the real
# deploy) sets this to "production" by default - config/settings.py refuses
# to start if this is "production" and DEBUG is still True. Leave unset for
# local dev; never set this to "production" alongside DEBUG=True.
ENVIRONMENT=development

# Production only (ignored when DEBUG=True). Defaults to True - the real
# hardened posture (forces HTTPS, Secure cookies, HSTS). Set to False only
# for a transitional bare-IP deploy with no domain/cert yet, so the site is
# actually browsable over plain HTTP until a real cert exists - flip back to
# True (or just unset it) the moment you have one.
FORCE_HTTPS=True

# Production only: the real public URL of this site (no trailing slash),
# used to build ABSOLUTE links from contexts with no request object -
# emails (password reset, MFA codes, notifications) and the open-tracking
# pixel embedded in every HTML email. Defaults to http://localhost:8000,
# which is unreachable from a real recipient's email client - if this is
# left unset in production, every "opened" status in Email Logs silently
# stays false forever, since the tracking pixel is pointed at "localhost"
# (the recipient's own machine, not your server), not because anything is
# actually broken in the tracking code itself.
SITE_URL=https://your-real-domain.example

# Optional. "Sign in with Google" stays hidden on Login/Signup until this
# is set AND a SuperAdmin turns it on from Feature Visibility - see
# accounts/google_auth.py. Get one from Google Cloud Console > APIs &
# Services > Credentials > Create Credentials > OAuth client ID > Web
# application, with SITE_URL above added under "Authorized JavaScript
# origins" (no client secret needed - the button flow only ever hands the
# browser a signed ID token, verified server-side against Google's own
# public keys).
GOOGLE_OAUTH_CLIENT_ID=

# Leave unset (commented out) to use SQLite locally.
# Example for PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/ai_client_portal
# DATABASE_URL=

# AI provider API keys are connected from the admin Providers page (DB-
# stored, encrypted at rest with FIELD_ENCRYPTION_KEY below) - not env vars.

# Encrypts Provider.api_key_encrypted at rest. Required in production
# (DEBUG=False) - generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Optional. Leave blank to disable error monitoring (default in dev).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Local dev/demo accounts, one per role - created/updated by
# `python manage.py create_demo_users`. Leave blank to skip creating that role.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Production-only: database backups (see docs/BACKUP_RESTORE.md). Not used
# locally - the backup_database command no-ops on SQLite regardless. Left
# unset, every deploy's pre-deploy backup attempt (.github/workflows/ci.yml)
# just logs a warning and continues rather than blocking - set these to
# actually get a real backup before each deploy applies new migrations.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
BACKUP_RETENTION_DAYS=30

# Background jobs (notification emails, daily trial-expiry sweep). Leave
# blank locally - tasks then run synchronously in-process instead of being
# queued (see config/settings.py CELERY_TASK_ALWAYS_EAGER).
REDIS_URL=

# Notification emails. Leave blank locally - emails print to the console
# instead of being sent (see logs/app.log or the terminal running the server).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Who gets emailed when an unhandled exception (500) reaches a real request
# in production. Comma-separated "Name:email" pairs - leave blank to skip
# alerting (nothing breaks, it just won't notify anyone).
ADMINS=Ops:ops@example.com
SERVER_EMAIL=

# Live Intelligence on the chat home page: real headlines from public news feeds,
# fetched on demand and cached 15 minutes. Set to False to turn it off entirely
# (no outbound fetches, section and commands hidden). Default: True.
LIVE_INTELLIGENCE_ENABLED=True

# ---------------------------------------------------------------------------
# Optional tuning. Everything below has a safe default in config/settings.py
# (or deployment/gunicorn.conf.py); leave commented out unless you need it.
# config/test_env_consistency.py fails if a variable the code reads is missing here.
# ---------------------------------------------------------------------------

# Full origins (scheme + host) allowed to POST behind the reverse proxy.
# CSRF_TRUSTED_ORIGINS=https://example.com

# Cookie flags, each defaulting to FORCE_HTTPS. Set alone when TLS ends at Cloudflare
# and the origin speaks plain HTTP but the browser still uses HTTPS.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# Set by the deploy step to the commit being run; shown by `manage.py ops_verify`.
# RELEASE_SHA=

# Gunicorn (deployment/gunicorn.conf.py). Every open chat reply holds one thread
# until it finishes, so workers x threads is the number of replies that can stream at once.
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
# GUNICORN_LOG_LEVEL=info
# PORT=

# Celery task limits, in seconds (soft raises inside the task, hard kills it).
# CELERY_TASK_TIME_LIMIT=1800
# CELERY_TASK_SOFT_TIME_LIMIT=1500

# Uploads.
# DEFAULT_MAX_UPLOAD_SIZE_MB=10
# DEFAULT_ALLOWED_FILE_EXTENSIONS=pdf,txt,csv,md,png,jpg,jpeg,docx,xlsx,json

# Outbound email timeout in seconds.
# EMAIL_TIMEOUT=10

# Failed logins per IP per hour, across all usernames (credential-stuffing guard).
# LOGIN_IP_FAILURE_LIMIT=30

# Server Media (SuperAdmin): disk-usage thresholds in percent used.
# MEDIA_DISK_WARN_PCT=80
# MEDIA_DISK_CRITICAL_PCT=90

# Server Media size filter (bytes) and the extra large-file thresholds (MB, comma separated).
# MEDIA_MEDIUM_MIN_BYTES=1048576
# MEDIA_LARGE_MIN_BYTES=10485760
# MEDIA_LARGE_THRESHOLDS_MB=50,100,500

# How much conversation one AI request may send (chat/context_window.py). The real
# per-model windows are not stored, so these are deliberately conservative assumptions.
# MODEL_CONTEXT_TOKENS_DEFAULT=32000
# MODEL_CONTEXT_TOKENS={"anthropic": 100000, "gemini": 100000, "openai_compatible": 32000}
# MODEL_CONTEXT_TOKENS_BY_MODEL={"some-model-id-fragment": 128000}

# PostgreSQL session timeouts in milliseconds, both off (0) by default. See config/db_options.py
# before setting: idle-in-transaction is the safe first step; statement_timeout also applies to
# migrations, the retention sweep and exports.
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=0
# DB_STATEMENT_TIMEOUT_MS=0

# One signed-in browser per account: signing in elsewhere signs the earlier browser out (accounts/single_session.py).
# Set to False to allow any number of simultaneous browsers.
# SINGLE_SESSION_PER_USER=True

# HTTPS behind Cloudflare (accounts/middleware.py). docker-compose.yml turns the first two on for production.
# ENFORCE_HTTPS_VIA_CLOUDFLARE=False
# CLOUDFLARE_HSTS_SECONDS=0
# Comma-separated CIDR ranges of Cloudflare's proxies, used to decide whether CF-Connecting-IP can be trusted.
# Defaults to Cloudflare's published list (https://www.cloudflare.com/ips/).
# CLOUDFLARE_IP_RANGES=173.245.48.0/20,103.21.244.0/22
