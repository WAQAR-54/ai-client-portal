{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": [
      "python manage.py migrate --noinput",
      "python manage.py collectstatic --noinput"
    ],
    "startCommand": "gunicorn -c deployment/gunicorn.conf.py config.wsgi:application"
  }
}
